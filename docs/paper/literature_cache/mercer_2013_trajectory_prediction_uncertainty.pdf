.hds-card{position:relative}.hds-card-grid .hds-card-grid-header{padding-left:30px;padding-right:30px}.hds-card-grid .hds-card-grid-cards{padding-left:20px;padding-right:20px}.hds-card .hds-card-inner{display:block;margin-left:auto;margin-right:auto;position:relative;width:calc(100% - 20px)}.hds-card .hds-card-content{width:100%}.hds-card-hover-zoom-image .hds-media-background{transition:transform .3s ease-in-out}.hds-card:hover .hds-card-hover-zoom-image .hds-media-background{transform:scale(1.05)}.hds-card .hds-card-thumbnail{display:block;overflow:hidden;padding:0;position:relative}.hds-card .hds-card-thumbnail:after{content:"";display:block;padding-bottom:56.25%}.hds-card-custom .hds-card-thumbnail:after{padding-bottom:75%}.hds-card-article-default .hds-card-thumbnail:after{padding-bottom:67%}.hds-card-article-graphical .hds-card-thumbnail:after{padding-bottom:140%}.hds-card-subtopic .hds-card-thumbnail:after,.hds-card-topic .hds-card-thumbnail:after{padding-bottom:150%}.hds-card-location .hds-card-thumbnail:after{padding-bottom:75%}.hds-card-gallery .hds-card-gallery-images{display:grid;gap:.25rem;grid-template-columns:1.75fr 1fr;grid-template-rows:1fr 1fr}.hds-card-gallery .hds-card-gallery-images .hds-media-background{overflow:hidden}.hds-card-gallery-image-1{grid-column:1/2;grid-row:1/3}.hds-card-gallery-image-2{grid-column:2/3;grid-row:1/2}.hds-card-gallery-image-3{grid-column:2/3;grid-row:2/3}.hds-media-background img{transition:transform .3s ease-in-out}.hds-media-background:hover img{transform:scale(1.05)}.hds-card-heading svg{height:.9em;min-width:.9em;width:.9em}

